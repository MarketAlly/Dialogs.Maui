<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Test.Pages.Demos.AdvancedDemoPage"
             Title="Advanced Features">

    <ContentPage.Resources>
        <Style x:Key="DemoButton" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="HeightRequest" Value="50"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="10">

            <Border BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}"
                    Padding="10"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout>
                    <Label Text="Last Result:" FontAttributes="Bold"/>
                    <Label x:Name="ResultLabel"
                           Text="Tap a button to see the result"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Theme Settings" FontSize="18" FontAttributes="Bold" Margin="0,10,0,5"/>

            <Button Text="Toggle Light/Dark Theme"
                    Clicked="OnToggleThemeClicked"
                    BackgroundColor="#673AB7"
                    Style="{StaticResource DemoButton}"/>

            <Label x:Name="CurrentThemeLabel"
                   Text="Current Theme: System"
                   HorizontalOptions="Center"
                   Margin="0,5"/>

            <Button Text="Custom Dialog Type"
                    Clicked="OnCustomDialogClicked"
                    BackgroundColor="#E91E63"
                    Style="{StaticResource DemoButton}"/>

            <Label Text="v1.2.0 Features" FontSize="18" FontAttributes="Bold" Margin="0,15,0,5"/>

            <Button Text="Title MaxLines Demo"
                    Clicked="OnTitleMaxLinesClicked"
                    BackgroundColor="#00BCD4"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Title LineBreakMode Demo"
                    Clicked="OnTitleLineBreakModeClicked"
                    BackgroundColor="#009688"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="HTML Description Demo"
                    Clicked="OnHtmlDescriptionClicked"
                    BackgroundColor="#FF9800"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Combined Features Demo"
                    Clicked="OnCombinedFeaturesClicked"
                    BackgroundColor="#F44336"
                    Style="{StaticResource DemoButton}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
