<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Test.Pages.Demos.AlertsDemoPage"
             Title="Alert Dialogs">

    <ContentPage.Resources>
        <Style x:Key="DemoButton" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="HeightRequest" Value="50"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="10">

            <Border BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}"
                    Padding="10"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout>
                    <Label Text="Last Result:" FontAttributes="Bold"/>
                    <Label x:Name="ResultLabel"
                           Text="Tap a button to see the result"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Basic Alerts" FontSize="18" FontAttributes="Bold" Margin="0,10,0,5"/>

            <Button Text="Success Alert"
                    Clicked="OnSuccessAlertClicked"
                    BackgroundColor="#4CAF50"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Error Alert"
                    Clicked="OnErrorAlertClicked"
                    BackgroundColor="#F44336"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Warning Alert"
                    Clicked="OnWarningAlertClicked"
                    BackgroundColor="#FF9800"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Info Alert"
                    Clicked="OnInfoAlertClicked"
                    BackgroundColor="#2196F3"
                    Style="{StaticResource DemoButton}"/>

            <Label Text="Text Handling" FontSize="18" FontAttributes="Bold" Margin="0,15,0,5"/>

            <Button Text="Long Title Alert"
                    Clicked="OnLongTitleAlertClicked"
                    BackgroundColor="#795548"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Long Description Alert"
                    Clicked="OnLongDescriptionAlertClicked"
                    BackgroundColor="#607D8B"
                    Style="{StaticResource DemoButton}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
