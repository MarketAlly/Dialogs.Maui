<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Test.Pages.Demos.DateTimeDemoPage"
             Title="Date &amp; Time Pickers">

    <ContentPage.Resources>
        <Style x:Key="DemoButton" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="HeightRequest" Value="50"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="10">

            <Border BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#E65100}"
                    Padding="10"
                    StrokeShape="RoundRectangle 8">
                <Label Text="New in v1.5.0" FontAttributes="Bold" TextColor="White"/>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}"
                    Padding="10"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout>
                    <Label Text="Last Result:" FontAttributes="Bold"/>
                    <Label x:Name="ResultLabel"
                           Text="Tap a button to see the result"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Date Picker" FontSize="18" FontAttributes="Bold" Margin="0,10,0,5"/>

            <Button Text="Basic Date Picker"
                    Clicked="OnDatePickerClicked"
                    BackgroundColor="#FF6D00"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Date Picker with Constraints"
                    Clicked="OnDatePickerWithConstraintsClicked"
                    BackgroundColor="#FF9100"
                    Style="{StaticResource DemoButton}"/>

            <Label Text="Time Picker" FontSize="18" FontAttributes="Bold" Margin="0,15,0,5"/>

            <Button Text="Basic Time Picker"
                    Clicked="OnTimePickerClicked"
                    BackgroundColor="#FFAB00"
                    TextColor="Black"
                    Style="{StaticResource DemoButton}"/>

            <Label Text="Combined" FontSize="18" FontAttributes="Bold" Margin="0,15,0,5"/>

            <Button Text="Date + Time Picker"
                    Clicked="OnDateTimePickerClicked"
                    BackgroundColor="#FFD600"
                    TextColor="Black"
                    Style="{StaticResource DemoButton}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
