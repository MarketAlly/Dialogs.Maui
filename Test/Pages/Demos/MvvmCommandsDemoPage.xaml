<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Test.Pages.Demos.MvvmCommandsDemoPage"
             Title="MVVM Commands">

    <ContentPage.Resources>
        <Style x:Key="DemoButton" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="HeightRequest" Value="50"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="10">

            <Border BackgroundColor="{AppThemeBinding Light=#E8EAF6, Dark=#283593}"
                    Padding="10"
                    StrokeShape="RoundRectangle 8">
                <Label Text="New in v1.5.0 - DialogCommands for MVVM" FontAttributes="Bold" TextColor="White"/>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}"
                    Padding="10"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout>
                    <Label Text="Last Result:" FontAttributes="Bold"/>
                    <Label x:Name="ResultLabel"
                           Text="Tap a button to see the result"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="These buttons use Command binding instead of Click handlers:"
                   FontSize="12"
                   TextColor="Gray"
                   Margin="0,10,0,5"/>

            <Button Text="Alert Command"
                    Command="{Binding AlertCommand}"
                    BackgroundColor="#3F51B5"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Confirm Command"
                    Command="{Binding ConfirmCommand}"
                    BackgroundColor="#303F9F"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Prompt Command"
                    Command="{Binding PromptCommand}"
                    BackgroundColor="#1A237E"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Date Picker Command"
                    Command="{Binding DatePickerCommand}"
                    BackgroundColor="#FF6D00"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Action List Command"
                    Command="{Binding ActionListCommand}"
                    BackgroundColor="#5C6BC0"
                    Style="{StaticResource DemoButton}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
