<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Test.Pages.Demos.PromptsDemoPage"
             Title="Prompts &amp; Editors">

    <ContentPage.Resources>
        <Style x:Key="DemoButton" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="HeightRequest" Value="50"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="10">

            <Border BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}"
                    Padding="10"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout>
                    <Label Text="Last Result:" FontAttributes="Bold"/>
                    <Label x:Name="ResultLabel"
                           Text="Tap a button to see the result"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Single-line Prompts" FontSize="18" FontAttributes="Bold" Margin="0,10,0,5"/>

            <Button Text="Text Input Prompt"
                    Clicked="OnTextPromptClicked"
                    BackgroundColor="#00BCD4"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Password Prompt"
                    Clicked="OnPasswordPromptClicked"
                    BackgroundColor="#3F51B5"
                    Style="{StaticResource DemoButton}"/>

            <Label Text="Multi-line Editors" FontSize="18" FontAttributes="Bold" Margin="0,15,0,5"/>

            <Button Text="Notes Editor"
                    Clicked="OnNotesEditorClicked"
                    BackgroundColor="#4CAF50"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Feedback Editor"
                    Clicked="OnFeedbackEditorClicked"
                    BackgroundColor="#8BC34A"
                    Style="{StaticResource DemoButton}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
