<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Test.Pages.Demos.ThemePresetsDemoPage"
             Title="Theme Presets">

    <ContentPage.Resources>
        <Style x:Key="DemoButton" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="HeightRequest" Value="50"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="10">

            <Border BackgroundColor="{AppThemeBinding Light=#F3E5F5, Dark=#6A1B9A}"
                    Padding="10"
                    StrokeShape="RoundRectangle 8">
                <Label Text="New in v1.5.0" FontAttributes="Bold" TextColor="White"/>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}"
                    Padding="10"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout>
                    <Label Text="Current Theme:" FontAttributes="Bold"/>
                    <Label x:Name="CurrentThemeLabel"
                           Text="System Default"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Material Design 3" FontSize="18" FontAttributes="Bold" Margin="0,10,0,5"/>

            <Button Text="Material Light"
                    Clicked="OnMaterialLightClicked"
                    BackgroundColor="#6750A4"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Material Dark"
                    Clicked="OnMaterialDarkClicked"
                    BackgroundColor="#D0BCFF"
                    TextColor="#381E72"
                    Style="{StaticResource DemoButton}"/>

            <Label Text="Microsoft Fluent Design" FontSize="18" FontAttributes="Bold" Margin="0,15,0,5"/>

            <Button Text="Fluent Light"
                    Clicked="OnFluentLightClicked"
                    BackgroundColor="#0078D4"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Fluent Dark"
                    Clicked="OnFluentDarkClicked"
                    BackgroundColor="#4CC2FF"
                    TextColor="Black"
                    Style="{StaticResource DemoButton}"/>

            <Label Text="Apple Cupertino (iOS)" FontSize="18" FontAttributes="Bold" Margin="0,15,0,5"/>

            <Button Text="Cupertino Light"
                    Clicked="OnCupertinoLightClicked"
                    BackgroundColor="#007AFF"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Cupertino Dark"
                    Clicked="OnCupertinoDarkClicked"
                    BackgroundColor="#0A84FF"
                    Style="{StaticResource DemoButton}"/>

            <Label Text="Reset" FontSize="18" FontAttributes="Bold" Margin="0,15,0,5"/>

            <Button Text="Reset to Default"
                    Clicked="OnResetThemeClicked"
                    BackgroundColor="#607D8B"
                    Style="{StaticResource DemoButton}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
