<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Test.Pages.Demos.ToastSnackbarDemoPage"
             Title="Toasts &amp; Snackbars">

    <ContentPage.Resources>
        <Style x:Key="DemoButton" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="HeightRequest" Value="50"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="10">

            <Border BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}"
                    Padding="10"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout>
                    <Label Text="Last Result:" FontAttributes="Bold"/>
                    <Label x:Name="ResultLabel"
                           Text="Tap a button to see the result"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Toast Notifications" FontSize="18" FontAttributes="Bold" Margin="0,10,0,5"/>

            <Button Text="Simple Toast"
                    Clicked="OnSimpleToastClicked"
                    BackgroundColor="#424242"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Success Toast"
                    Clicked="OnSuccessToastClicked"
                    BackgroundColor="#4CAF50"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Error Toast"
                    Clicked="OnErrorToastClicked"
                    BackgroundColor="#F44336"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Toast at Top"
                    Clicked="OnTopToastClicked"
                    BackgroundColor="#5C6BC0"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Long Duration Toast"
                    Clicked="OnLongToastClicked"
                    BackgroundColor="#7E57C2"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Multiple Stacked Toasts"
                    Clicked="OnStackedToastsClicked"
                    BackgroundColor="#AB47BC"
                    Style="{StaticResource DemoButton}"/>

            <Label Text="Toast Positions" FontSize="16" FontAttributes="Bold" Margin="0,10,0,5"/>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Button Grid.Row="0" Grid.Column="0" Text="Top Left" Clicked="OnTopLeftToastClicked" BackgroundColor="#43A047" Style="{StaticResource DemoButton}"/>
                <Button Grid.Row="0" Grid.Column="1" Text="Top Right" Clicked="OnTopRightToastClicked" BackgroundColor="#7CB342" Style="{StaticResource DemoButton}"/>
                <Button Grid.Row="1" Grid.Column="0" Text="Bottom Left" Clicked="OnBottomLeftToastClicked" BackgroundColor="#00897B" Style="{StaticResource DemoButton}"/>
                <Button Grid.Row="1" Grid.Column="1" Text="Bottom Right" Clicked="OnBottomRightToastClicked" BackgroundColor="#00ACC1" Style="{StaticResource DemoButton}"/>
            </Grid>

            <Label Text="Snackbar Notifications" FontSize="18" FontAttributes="Bold" Margin="0,15,0,5"/>

            <Button Text="Simple Snackbar"
                    Clicked="OnSimpleSnackbarClicked"
                    BackgroundColor="#795548"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Snackbar with Undo"
                    Clicked="OnUndoSnackbarClicked"
                    BackgroundColor="#FF7043"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Snackbar with Retry"
                    Clicked="OnRetrySnackbarClicked"
                    BackgroundColor="#EF5350"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Snackbar with Icon"
                    Clicked="OnIconSnackbarClicked"
                    BackgroundColor="#42A5F5"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Indefinite Snackbar"
                    Clicked="OnIndefiniteSnackbarClicked"
                    BackgroundColor="#66BB6A"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Multiple Stacked"
                    Clicked="OnStackedSnackbarsClicked"
                    BackgroundColor="#26A69A"
                    Style="{StaticResource DemoButton}"/>

            <Button Text="Snackbar at Top"
                    Clicked="OnTopSnackbarClicked"
                    BackgroundColor="#5C6BC0"
                    Style="{StaticResource DemoButton}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
