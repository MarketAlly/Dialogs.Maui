<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Test.Pages.DialogDemoPage"
             Title="Dialog Demos">

    <ContentPage.Resources>
        <Style x:Key="CategoryButton" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HeightRequest" Value="60"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="10">

            <Label Text="MarketAlly Dialog Library"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,10,0,5"/>

            <Label Text="v1.5.0 - Tap a category to explore"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,0,0,15"/>

            <Button Text="Alerts"
                    Clicked="OnAlertsCategoryClicked"
                    BackgroundColor="#4CAF50"
                    Style="{StaticResource CategoryButton}"/>

            <Button Text="Confirmations"
                    Clicked="OnConfirmationsCategoryClicked"
                    BackgroundColor="#2196F3"
                    Style="{StaticResource CategoryButton}"/>

            <Button Text="Prompts &amp; Editors"
                    Clicked="OnPromptsCategoryClicked"
                    BackgroundColor="#00BCD4"
                    Style="{StaticResource CategoryButton}"/>

            <Button Text="Date &amp; Time Pickers (v1.5.0)"
                    Clicked="OnDateTimeCategoryClicked"
                    BackgroundColor="#FF9800"
                    Style="{StaticResource CategoryButton}"/>

            <Button Text="Action Lists"
                    Clicked="OnActionListsCategoryClicked"
                    BackgroundColor="#9C27B0"
                    Style="{StaticResource CategoryButton}"/>

            <Button Text="Color Picker"
                    Clicked="OnColorPickerCategoryClicked"
                    BackgroundColor="#E91E63"
                    Style="{StaticResource CategoryButton}"/>

            <Button Text="Loading Dialogs"
                    Clicked="OnLoadingCategoryClicked"
                    BackgroundColor="#607D8B"
                    Style="{StaticResource CategoryButton}"/>

            <Button Text="Toasts &amp; Snackbars"
                    Clicked="OnToastSnackbarCategoryClicked"
                    BackgroundColor="#795548"
                    Style="{StaticResource CategoryButton}"/>

            <Button Text="Theme Presets (v1.5.0)"
                    Clicked="OnThemePresetsCategoryClicked"
                    BackgroundColor="#673AB7"
                    Style="{StaticResource CategoryButton}"/>

            <Button Text="MVVM Commands (v1.5.0)"
                    Clicked="OnMvvmCommandsCategoryClicked"
                    BackgroundColor="#3F51B5"
                    Style="{StaticResource CategoryButton}"/>

            <Button Text="Advanced Features"
                    Clicked="OnAdvancedCategoryClicked"
                    BackgroundColor="#F44336"
                    Style="{StaticResource CategoryButton}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
